{
  "implementation": "@altopelago/sansa",
  "version": "0.9.0",
  "profiles": [
    "value-semantics-minimum-consumer",
    "aeon.value.default.v1",
    "aeon.value.string.codepoint.v1",
    "aeon.value.string.natural.ascii.v1",
    "aeon.value.string.locale.fr.v1",
    "addressing",
    "resolve",
    "query"
  ],
  "capabilities": [
    "AEON.ValueSemantics",
    "SANSA.Addressing",
    "SANSA.Resolve",
    "SANSA.Query",
    "SANSA.Mutate",
    "SANSA.Transform"
  ],
  "core": {
    "valueSemanticsMinimumConsumer": true,
    "addressing": true,
    "resolve": true,
    "query": true,
    "mutate": false
  },
  "experimentalCapabilities": [
    {
      "id": "sansa.mutate.plan.v1",
      "capability": "SANSA.Mutate",
      "category": "mutation-plan",
      "maturity": "experimental",
      "operations": [
        "create",
        "replace",
        "remove",
        "insert",
        "move"
      ],
      "adapterCapabilityFlags": [
        "supportsCreate",
        "supportsReplace",
        "supportsRemove",
        "supportsOrderedInsert",
        "supportsMove",
        "supportsStableBindingIdentity",
        "supportsAtomicApply"
      ]
    }
  ],
  "policies": [
    {
      "id": "validation",
      "capability": "SANSA.Query",
      "category": "policy",
      "maturity": "experimental"
    }
  ],
  "budgetOptions": [
    {
      "id": "maxFromBindings",
      "capability": "SANSA.Query",
      "category": "evaluation-budget",
      "phase": "from"
    },
    {
      "id": "maxWhereCandidates",
      "capability": "SANSA.Query",
      "category": "evaluation-budget",
      "phase": "where"
    },
    {
      "id": "maxOrderCandidates",
      "capability": "SANSA.Query",
      "category": "evaluation-budget",
      "phase": "order"
    },
    {
      "id": "maxResultRecords",
      "capability": "SANSA.Query",
      "category": "evaluation-budget",
      "phase": "select"
    },
    {
      "id": "maxOperations",
      "capability": "SANSA.Mutate",
      "category": "mutation-budget",
      "phase": "plan-apply",
      "maturity": "experimental"
    },
    {
      "id": "maxPreconditions",
      "capability": "SANSA.Mutate",
      "category": "mutation-budget",
      "phase": "plan-apply",
      "maturity": "experimental"
    }
  ],
  "extensions": [
    {
      "id": "sansa.transform.objectFrom",
      "name": "objectFrom",
      "capability": "SANSA.Transform",
      "category": "library",
      "maturity": "experimental"
    },
    {
      "id": "sansa.transform.fieldsFrom",
      "name": "fieldsFrom",
      "capability": "SANSA.Transform",
      "category": "library",
      "maturity": "experimental"
    }
  ],
  "limits": {
    "portablePositionIndexMax": 999999,
    "defaultPositionIndexMax": 999999
  },
  "portabilityWarnings": [
    "SANSA_NON_PORTABLE_POSITION_INDEX"
  ]
}
