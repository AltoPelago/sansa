{
  "implementation": "@altopelago/sansa",
  "version": "0.9.1",
  "profiles": [
    "value-semantics-minimum-consumer",
    "aeon.value.default.v1",
    "aeon.value.string.codepoint.v1",
    "aeon.value.string.natural.ascii.v1",
    "aeon.value.string.locale.fr.v1",
    "addressing",
    "resolve",
    "query",
    "instruction"
  ],
  "capabilities": [
    "AEON.ValueSemantics",
    "SANSA.Addressing",
    "SANSA.Resolve",
    "SANSA.Query",
    "SANSA.Instruction",
    "SANSA.Mutate",
    "SANSA.Transform",
    "SANSA.Graph"
  ],
  "core": {
    "valueSemanticsMinimumConsumer": true,
    "addressing": true,
    "resolve": true,
    "query": true,
    "instruction": false,
    "mutate": false
  },
  "experimentalCapabilities": [
    {
      "id": "sansa.graph.structured.one-hop.v1",
      "capability": "SANSA.Graph",
      "category": "declared-relationship-traversal",
      "maturity": "experimental",
      "entryPoints": ["traverseGraph", "traverseGraphSequence"],
      "semantics": [
        "structured declarations only",
        "one-hop directed traversal",
        "explicit bounded multi-hop declaration sequences",
        "complete ordered multi-hop path provenance",
        "index-neutral traversal through optional namespace lookup acceleration",
        "explicit omit-or-error cycle policy",
        "explicit schema-version applicability",
        "source and target semantic-type constraints",
        "per-source edge cardinality constraints",
        "same-namespace traversal only",
        "absolute address reference targets",
        "address-valued relationship edges",
        "deterministic Binding Set and Path Set",
        "explicit Query-before and contextual Query/Transform-after composition",
        "mandatory explicit budgets",
        "aggregate depth, node, edge, and result budgets across hops",
        "independent authorization callback per traversal step",
        "read-only"
      ],
      "boundaries": [
        "relationship declaration authority remains external to SANSA",
        "AEOS or an AEOS-adjacent profile owns relationship meaning",
        "target adapters own index health, rebuild, and scan fallback",
        "traversal conveys location, never authorization",
        "Graph authorization does not authorize composed Query reads",
        "relationship mutation remains SANSA.Mutate responsibility",
        "no graph storage, indexing, query language, or implicit recursive traversal claim"
      ]
    },
    {
      "id": "sansa.instruction.prototype.v1",
      "capability": "SANSA.Instruction",
      "category": "instruction-parse-lower-plan",
      "maturity": "experimental",
      "verbs": [
        "create",
        "replace",
        "remove",
        "insert",
        "append",
        "move"
      ],
      "aliases": [
        {
          "sourceVerb": "append",
          "canonicalVerb": "insert",
          "placement": "last"
        }
      ],
      "entryPoints": [
        "parseInstruction",
        "lowerInstruction",
        "planInstruction"
      ],
      "boundaries": [
        "lowering emits SANSA.Mutate request operations",
        "append is source-level Instruction sugar and lowers to insert-last mutation intent",
        "require clauses lower into SANSA.Mutate preconditions",
        "because and by clauses are inert claimed provenance, not authorization or authentication",
        "planning delegates to SANSA.Mutate plan API",
        "target-surface validation remains a downstream Mutate/adapter boundary",
        "apply remains SANSA.Mutate adapter responsibility"
      ]
    },
    {
      "id": "sansa.mutate.plan.v1",
      "capability": "SANSA.Mutate",
      "category": "mutation-plan",
      "maturity": "experimental",
      "operations": [
        "create",
        "replace",
        "remove",
        "insert",
        "move"
      ],
      "valueIntentHints": [
        "datatype",
        "kind"
      ],
      "targetSurfaceValidation": [
        "aeon",
        "json",
        "custom"
      ],
      "entryPoints": [
        "planMutation",
        "validateMutationPlanTarget",
        "applyMutationPlan"
      ],
      "adapterCapabilityFlags": [
        "supportsCreate",
        "supportsReplace",
        "supportsRemove",
        "supportsOrderedInsert",
        "supportsMove",
        "supportsStableBindingIdentity",
        "supportsAtomicApply"
      ]
    },
    {
      "id": "sansa.mutate.policy.planFilter",
      "capability": "SANSA.Mutate",
      "category": "policy",
      "maturity": "experimental",
      "surface": "workbench",
      "entryPoints": [
        "tools/mutate-web",
        "/api/mutate options.policySource"
      ],
      "policyRuleFields": [
        "operation",
        "operations",
        "target",
        "parent",
        "container",
        "source",
        "anchor",
        "name",
        "names",
        "datatype",
        "datatypes",
        "kind",
        "kinds",
        "value",
        "values"
      ],
      "diagnostics": [
        "SANSA_MUTATE_POLICY_INVALID_JSON",
        "SANSA_MUTATE_POLICY_INVALID",
        "SANSA_MUTATE_POLICY_INVALID_ADDRESS",
        "SANSA_MUTATE_POLICY_DENIED"
      ],
      "boundaries": [
        "policy is trusted consumer input, not document input",
        "policy authorizes or denies already planned mutation intent",
        "policy must not rewrite mutation plans or make schema-invalid values valid",
        "unsupported policy fields fail closed instead of being ignored",
        "policy remains outside SANSA.Mutate core conformance"
      ]
    }
  ],
  "policies": [
    {
      "id": "dynamic-address-activation",
      "capability": "SANSA.Query",
      "category": "authority",
      "maturity": "proposal",
      "requiredFor": "path",
      "modes": [
        "trusted",
        "constrained"
      ]
    },
    {
      "id": "validation",
      "capability": "SANSA.Query",
      "category": "policy",
      "maturity": "experimental"
    }
  ],
  "budgetOptions": [
    {
      "id": "maxFromBindings",
      "capability": "SANSA.Query",
      "category": "evaluation-budget",
      "phase": "from"
    },
    {
      "id": "maxWhereCandidates",
      "capability": "SANSA.Query",
      "category": "evaluation-budget",
      "phase": "where"
    },
    {
      "id": "maxOrderCandidates",
      "capability": "SANSA.Query",
      "category": "evaluation-budget",
      "phase": "order"
    },
    {
      "id": "maxResultRecords",
      "capability": "SANSA.Query",
      "category": "evaluation-budget",
      "phase": "select"
    },
    {
      "id": "maxOperations",
      "capability": "SANSA.Mutate",
      "category": "mutation-budget",
      "phase": "plan-apply",
      "maturity": "experimental"
    },
    {
      "id": "maxPreconditions",
      "capability": "SANSA.Mutate",
      "category": "mutation-budget",
      "phase": "plan-apply",
      "maturity": "experimental"
    },
    {
      "id": "maxValueNodes",
      "capability": "SANSA.Mutate",
      "category": "mutation-budget",
      "phase": "plan-apply",
      "maturity": "experimental"
    },
    {
      "id": "maxValueDepth",
      "capability": "SANSA.Mutate",
      "category": "mutation-budget",
      "phase": "plan-apply",
      "maturity": "experimental"
    },
    {
      "id": "maxStringLength",
      "capability": "SANSA.Mutate",
      "category": "mutation-budget",
      "phase": "plan-apply",
      "maturity": "experimental"
    }
  ],
  "extensions": [
    {
      "id": "sansa.transform.objectFrom",
      "name": "objectFrom",
      "capability": "SANSA.Transform",
      "category": "library",
      "maturity": "experimental"
    },
    {
      "id": "sansa.transform.fieldsFrom",
      "name": "fieldsFrom",
      "capability": "SANSA.Transform",
      "category": "library",
      "maturity": "experimental"
    }
  ],
  "limits": {
    "portablePositionIndexMax": 999999,
    "defaultPositionIndexMax": 999999
  },
  "portabilityWarnings": [
    "SANSA_NON_PORTABLE_POSITION_INDEX"
  ]
}
