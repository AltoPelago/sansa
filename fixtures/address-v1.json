{
  "meta": {
    "version": "0.1.0",
    "spec": "sansa-address-v1",
    "description": "Initial SANSA Address parser fixtures."
  },
  "cases": [
    {
      "id": "root-absolute",
      "source": "$",
      "valid": true,
      "canonical": "$",
      "exact": true
    },
    {
      "id": "root-contextual",
      "source": "?",
      "valid": true,
      "canonical": "?",
      "exact": true
    },
    {
      "id": "exact-member-index-attribute-local",
      "source": "$.inventory[0].[\"display.name\"].@.<\"pdf\">",
      "valid": true,
      "canonical": "$.inventory[0].[\"display.name\"].@.<\"pdf\">",
      "exact": true
    },
    {
      "id": "canonicalize-safe-quoted-member",
      "source": "$.[\"name\"]",
      "valid": true,
      "canonical": "$.name",
      "exact": true,
      "selectors": ["member"]
    },
    {
      "id": "quoted-member-escapes",
      "source": "$.[\"line\\nfeed\"].[\"tab\\tname\"].[\"quote\\\"name\"]",
      "valid": true,
      "canonical": "$.[\"line\\nfeed\"].[\"tab\\tname\"].[\"quote\\\"name\"]",
      "exact": true,
      "selectors": ["member", "member", "member"]
    },
    {
      "id": "quoted-member-unicode-escape",
      "source": "$.[\"emoji_\\u{1F642}\"]",
      "valid": true,
      "canonical": "$.[\"emoji_🙂\"]",
      "exact": true,
      "selectors": ["member"]
    },
    {
      "id": "contextual-local-space",
      "source": "?.<\"request\">.user_id",
      "valid": true,
      "canonical": "?.<\"request\">.user_id",
      "exact": true,
      "root": "contextual",
      "selectors": ["localSpace", "member"]
    },
    {
      "id": "expanded-selectors",
      "source": "$.items.*#text%stringLiteral.(\"item?*\").**",
      "valid": true,
      "canonical": "$.items.*#text%stringLiteral.(\"item?*\").**",
      "exact": false,
      "selectors": [
        "member",
        "directExpansion",
        "semanticTypeFilter",
        "representationKindFilter",
        "namePattern",
        "descendantExpansion"
      ]
    },
    {
      "id": "direct-expansion-only",
      "source": "$.items.*",
      "valid": true,
      "canonical": "$.items.*",
      "exact": false,
      "selectors": ["member", "directExpansion"]
    },
    {
      "id": "position-range-bounded",
      "source": "$.items[2..5]",
      "valid": true,
      "canonical": "$.items[2..5]",
      "exact": false,
      "selectors": ["member", "positionRange"]
    },
    {
      "id": "position-range-open-end",
      "source": "$.items[2..]",
      "valid": true,
      "canonical": "$.items[2..]",
      "exact": false,
      "selectors": ["member", "positionRange"]
    },
    {
      "id": "position-range-open-start",
      "source": "$.items[..5]",
      "valid": true,
      "canonical": "$.items[..5]",
      "exact": false,
      "selectors": ["member", "positionRange"]
    },
    {
      "id": "parent-selector",
      "source": "$.items[1].^.sku",
      "valid": true,
      "canonical": "$.items[1].^.sku",
      "exact": false,
      "selectors": ["member", "position", "parent", "member"]
    },
    {
      "id": "quoted-caret-member",
      "source": "$.[\"^\"]",
      "valid": true,
      "canonical": "$.[\"^\"]",
      "exact": true,
      "selectors": ["member"]
    },
    {
      "id": "descendant-expansion-only",
      "source": "$.items.**",
      "valid": true,
      "canonical": "$.items.**",
      "exact": false,
      "selectors": ["member", "descendantExpansion"]
    },
    {
      "id": "filters-only",
      "source": "$#record%object",
      "valid": true,
      "canonical": "$#record%object",
      "exact": false,
      "selectors": ["semanticTypeFilter", "representationKindFilter"]
    },
    {
      "id": "qualified-union",
      "source": "$.result:number|nan",
      "valid": true,
      "canonical": "$.result:number|nan",
      "exact": true,
      "qualifierTerms": ["number", "nan"]
    },
    {
      "id": "qualified-generic",
      "source": "$.inventory:list<string>",
      "valid": true,
      "canonical": "$.inventory:list<string>",
      "exact": true,
      "qualifierTerms": ["list"]
    },
    {
      "id": "qualified-repeated-parameter-groups",
      "source": "$.key:tuple<x><y>",
      "valid": true,
      "canonical": "$.key:tuple<x><y>",
      "exact": true,
      "qualifierTerms": ["tuple"]
    },
    {
      "id": "qualified-token-argument",
      "source": "$.version:sep[.]",
      "valid": true,
      "canonical": "$.version:sep[.]",
      "exact": true,
      "qualifierTerms": ["sep"]
    },
    {
      "id": "qualified-quoted-argument",
      "source": "$.inventory:csv[\",\"]",
      "valid": true,
      "canonical": "$.inventory:csv[\",\"]",
      "exact": true,
      "qualifierTerms": ["csv"]
    },
    {
      "id": "qualified-repeated-arguments",
      "source": "$.key:string[\",\"][\".\"]",
      "valid": true,
      "canonical": "$.key:string[\",\"][\".\"]",
      "exact": true,
      "qualifierTerms": ["string"]
    },
    {
      "id": "qualified-rich-host-surface",
      "source": "$.claim:type<type>[arg]",
      "valid": true,
      "canonical": "$.claim:type<type>[arg]",
      "exact": true,
      "qualifierTerms": ["type"]
    },
    {
      "id": "reject-raw-comma-argument",
      "source": "$.inventory:csv[,]",
      "valid": false,
      "error": "SANSA_INVALID_QUALIFIER_ARGUMENT_CHAR"
    },
    {
      "id": "reject-empty-qualifier-argument",
      "source": "$.inventory:csv[]",
      "valid": false,
      "error": "SANSA_EXPECTED_QUALIFIER_ARGUMENT"
    },
    {
      "id": "reject-leading-zero-index",
      "source": "$.items[01]",
      "valid": false,
      "error": "SANSA_LEADING_ZERO_INDEX"
    },
    {
      "id": "reject-empty-position-range",
      "source": "$.items[..]",
      "valid": false,
      "error": "SANSA_EMPTY_POSITION_RANGE"
    },
    {
      "id": "reject-leading-zero-range-end",
      "source": "$.items[1..02]",
      "valid": false,
      "error": "SANSA_LEADING_ZERO_INDEX"
    },
    {
      "id": "max-position-index",
      "source": "$.items[1000000]",
      "valid": true,
      "canonical": "$.items[1000000]",
      "exact": true,
      "selectors": ["member", "position"]
    },
    {
      "id": "max-position-range-endpoint",
      "source": "$.items[0..1000000]",
      "valid": true,
      "canonical": "$.items[0..1000000]",
      "exact": false,
      "selectors": ["member", "positionRange"]
    },
    {
      "id": "reject-position-index-above-limit",
      "source": "$.items[1000001]",
      "valid": false,
      "error": "SANSA_POSITION_INDEX_LIMIT_EXCEEDED"
    },
    {
      "id": "reject-position-range-endpoint-above-limit",
      "source": "$.items[0..1000001]",
      "valid": false,
      "error": "SANSA_POSITION_INDEX_LIMIT_EXCEEDED"
    },
    {
      "id": "reject-empty-quoted-member",
      "source": "$.[\"\"]",
      "valid": false,
      "error": "SANSA_EMPTY_MEMBER_NAME"
    },
    {
      "id": "reject-empty-local-space",
      "source": "$.<\"\">",
      "valid": false,
      "error": "SANSA_EMPTY_LOCAL_SPACE_NAME"
    },
    {
      "id": "reject-raw-whitespace",
      "source": "$.bad name",
      "valid": false,
      "error": "SANSA_UNEXPECTED_WHITESPACE"
    },
    {
      "id": "reject-invalid-escape",
      "source": "$.[\"bad\\q\"]",
      "valid": false,
      "error": "SANSA_INVALID_ESCAPE"
    },
    {
      "id": "reject-invalid-unicode-scalar",
      "source": "$.[\"bad\\u{D800}\"]",
      "valid": false,
      "error": "SANSA_INVALID_UNICODE_SCALAR"
    },
    {
      "id": "reject-nested-qualifier-union",
      "source": "$.value:list<string|number>",
      "valid": false,
      "error": "SANSA_INVALID_QUALIFIER"
    },
    {
      "id": "reject-compact-attribute-bare",
      "source": "$.a@id",
      "valid": false,
      "error": "SANSA_UNEXPECTED_CHARACTER"
    },
    {
      "id": "reject-compact-attribute-quoted",
      "source": "$.a@[\"id\"]",
      "valid": false,
      "error": "SANSA_UNEXPECTED_CHARACTER"
    },
    {
      "id": "reject-half-migrated-attribute-bare",
      "source": "$.a.@id",
      "valid": false,
      "error": "SANSA_UNEXPECTED_CHARACTER"
    },
    {
      "id": "reject-half-migrated-attribute-quoted",
      "source": "$.a.@[\"id\"]",
      "valid": false,
      "error": "SANSA_EXPECTED_INDEX"
    }
  ]
}
