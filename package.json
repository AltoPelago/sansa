{
  "name": "@altopelago/sansa",
  "version": "0.1.0",
  "description": "Shared SANSA address parser and model.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "docs",
    "fixtures",
    "scripts",
    "stress-tests",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "cts": "npm run cts:address && npm run cts:resolve && npm run cts:query",
    "cts:address": "node scripts/cts-address.mjs",
    "cts:resolve": "node scripts/cts-resolve.mjs",
    "cts:query": "node scripts/cts-query.mjs",
    "stress": "node scripts/stress-addresses.mjs",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "sansa",
    "aeonite",
    "address",
    "resolve",
    "query",
    "parser"
  ]
}
