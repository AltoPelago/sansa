{
  "name": "@altopelago/sansa",
  "version": "0.9.0",
  "description": "Semantic Address NameSpace Abstraction parser, resolver, and query toolkit.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "bin": {
    "sansa-query": "./scripts/query.mjs"
  },
  "files": [
    "src",
    "docs",
    "fixtures",
    "scripts",
    "tools",
    "stress-tests",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AltoPelago/sansa.git"
  },
  "bugs": {
    "url": "https://github.com/AltoPelago/sansa/issues"
  },
  "homepage": "https://github.com/AltoPelago/sansa#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cts": "npm run cts:value-semantics && npm run cts:address && npm run cts:resolve && npm run cts:query",
    "cts:value-semantics": "node scripts/cts-value-semantics.mjs",
    "cts:address": "node scripts/cts-address.mjs",
    "cts:resolve": "node scripts/cts-resolve.mjs",
    "cts:query": "node scripts/cts-query.mjs",
    "cts:query:experimental": "node scripts/cts-query.mjs --include-experimental",
    "query": "node scripts/query.mjs",
    "query:web": "node scripts/query-web.mjs",
    "stress": "node scripts/stress-addresses.mjs",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "sansa",
    "aeonite",
    "aeon",
    "address",
    "addressing",
    "resolve",
    "query",
    "parser"
  ]
}
