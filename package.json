{
  "name": "@altopelago/sansa",
  "version": "0.15.0-rc.1",
  "description": "Semantic Address NameSpace Abstraction parser, resolver, and query toolkit.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./parsing/selector-cursor": {
      "types": "./src/selector-cursor.d.ts",
      "import": "./src/selector-cursor.js"
    },
    "./query-metadata": {
      "types": "./src/query-metadata.d.ts",
      "import": "./src/query-metadata.js"
    }
  },
  "bin": {
    "sansa-query": "./scripts/query.mjs",
    "sansa-instruction": "./scripts/instruction.mjs"
  },
  "files": [
    "src",
    "docs",
    "conformance",
    "fixtures",
    "scripts",
    "tools",
    "stress-tests",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AltoPelago/sansa.git"
  },
  "bugs": {
    "url": "https://github.com/AltoPelago/sansa/issues"
  },
  "homepage": "https://github.com/AltoPelago/sansa#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cts": "npm run cts:value-semantics && npm run cts:address && npm run cts:resolve && npm run cts:query",
    "cts:value-semantics": "node scripts/cts-value-semantics.mjs",
    "cts:aeonic-comparison": "node scripts/cts-aeonic-comparison.mjs",
    "cts:address": "node scripts/cts-address.mjs",
    "cts:resolve": "node scripts/cts-resolve.mjs",
    "cts:query": "node scripts/cts-query.mjs",
    "cts:query:experimental": "node scripts/cts-query.mjs --include-experimental",
    "cts:instruction": "node scripts/cts-instruction.mjs",
    "cts:mutate": "node scripts/cts-mutate.mjs",
    "instruction": "node scripts/instruction.mjs",
    "query": "node scripts/query.mjs",
    "query:web": "node scripts/query-web.mjs",
    "mutate:web": "node scripts/query-web.mjs",
    "stress": "node scripts/stress-addresses.mjs",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check",
    "version:recover": "node scripts/version.mjs recover",
    "validate:cts-claims": "node scripts/validate-cts-claims.mjs",
    "test": "node --test test/*.test.js",
    "test:rust": "cargo fmt --all --check --manifest-path implementations/rust/Cargo.toml && cargo clippy --locked --workspace --all-features --all-targets --manifest-path implementations/rust/Cargo.toml -- -D warnings && cargo test --locked --workspace --all-features --all-targets --manifest-path implementations/rust/Cargo.toml",
    "cts:aeonic-arithmetic": "node scripts/cts-aeonic-arithmetic.mjs",
    "cts:address:child-identity": "node scripts/cts-address.mjs --child-identity",
    "cts:resolve:child-identity": "node scripts/cts-resolve.mjs --child-identity",
    "playground": "node scripts/playground.mjs",
    "cts:aeonic-rational-arithmetic": "node scripts/cts-aeonic-rational-arithmetic.mjs",
    "cts:aeonic-rational-arithmetic:capacity": "python3 scripts/calibrate-aeonic-rational-capacity.py --sut 'node scripts/cts-aeonic-rational-arithmetic-adapter.mjs'",
    "cts:aeonic-temporal": "node scripts/cts-aeonic-temporal.mjs",
    "cts:aeonic-temporal:capacity": "python3 scripts/calibrate-aeonic-temporal-capacity.py --sut 'node scripts/cts-aeonic-temporal-civil-date-adapter.mjs'",
    "cts:aeonic-datetime": "node scripts/cts-aeonic-datetime.mjs",
    "cts:aeonic-datetime:capacity": "python3 scripts/calibrate-aeonic-datetime-capacity.py --sut 'node scripts/cts-aeonic-temporal-civil-datetime-adapter.mjs'",
    "cts:aeonic-clock": "node scripts/cts-aeonic-clock.mjs",
    "cts:aeonic-clock:capacity": "python3 scripts/calibrate-aeonic-clock-capacity.py --sut 'node scripts/cts-aeonic-temporal-civil-clock-adapter.mjs'",
    "cts:aeonic-anchor": "node scripts/cts-aeonic-anchor.mjs",
    "cts:aeonic-anchor:capacity": "python3 scripts/calibrate-aeonic-anchor-capacity.py --sut 'node scripts/cts-aeonic-temporal-civil-anchor-adapter.mjs'"
  },
  "keywords": [
    "sansa",
    "aeonite",
    "aeon",
    "address",
    "addressing",
    "resolve",
    "query",
    "parser"
  ],
  "devDependencies": {
    "@altopelago/aeon-highlight": "file:.candidate-packages/altopelago-aeon-highlight-0.17.0-rc.1-3b1c408c104a.tgz",
    "@altopelago/aeon-lexer": "file:.candidate-packages/altopelago-aeon-lexer-0.17.0-rc.1-ac967ffcab16.tgz"
  }
}
