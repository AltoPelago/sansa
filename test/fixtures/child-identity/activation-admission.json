{
  "description": "P4-03 constrained identity activation candidate; local fixtures, not a promoted CTS suite. Per-engine legacy denial diagnostics are explicit.",
  "namespace": {
    "supportsIdentity": true,
    "root": {
      "address": "$",
      "identity": "rootId",
      "children": [
        {
          "address": "$.items",
          "name": "items",
          "identity": "itemsId",
          "children": [
            {
              "address": "$.items[0]",
              "index": 0,
              "identity": "first",
              "children": [
                {
                  "address": "$.items[0].name",
                  "name": "name",
                  "identity": "label",
                  "value": "B",
                  "children": []
                }
              ]
            },
            {
              "address": "$.items[1]",
              "index": 1,
              "identity": "second",
              "children": [
                {
                  "address": "$.items[1].name",
                  "name": "name",
                  "identity": "label",
                  "value": "A",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "address": "$.selector",
          "name": "selector",
          "children": []
        }
      ]
    }
  },
  "tests": [
    {
      "id": "explicit-child",
      "path": "$.items.\\first\\",
      "options": {
        "addressActivation": {
          "allowedRoots": [
            "$.items"
          ],
          "allowedSelectors": [
            "member",
            "position",
            "childIdentity"
          ],
          "allowContextualRoot": false
        }
      },
      "expected": {
        "ok": true,
        "identityCalls": 2,
        "selected": [
          [
            "$.items[0]"
          ]
        ]
      }
    },
    {
      "id": "chain",
      "path": "$.items.\\first\\.\\label\\",
