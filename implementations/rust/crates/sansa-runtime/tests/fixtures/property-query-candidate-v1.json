{
  "meta": {
    "suite_id": "property-query",
    "lane": "sansa-properties",
    "capability": "SANSA.Resolve",
    "profile": "sansa-properties-read-only-candidate-0.2",
    "sut_protocol": "sansa-properties-preparation-v0.1",
    "spec_refs": [
      "aeonite-specs/sources/sansa/v1/property-selectors-v1.aeon"
    ]
  },
  "id": "property-query",
  "title": "Property candidate query",
  "tests": [
    {
      "id": "sansa-properties-query-current-key",
      "description": "query current key",
      "input": {
        "operation": "query",
        "namespace": "properties",
        "source": "from $.document\nselect .&key(\"document\")"
      },
      "expected": {
        "ok": true,
        "records": [
          {
            "candidate": "doc",
            "valueBindings": [
              "doc"
            ]
          }
        ],
        "calls": {
          "scope": 1,
          "key": 1
        }
      },
      "covers": [
        "query"
      ]
    },
    {
      "id": "sansa-properties-query-context-key",
      "description": "query context key",
      "input": {
        "operation": "query",
        "namespace": "properties",
        "source": "from $.document\nselect ?&key(\"document\")"
      },
      "expected": {
        "ok": true,
        "records": [
          {
            "candidate": "doc",
            "valueBindings": []
          }
        ],
        "calls": {
          "scope": 1,
          "key": 0
        }
      },
      "covers": [
        "query"
      ]
    },
    {
