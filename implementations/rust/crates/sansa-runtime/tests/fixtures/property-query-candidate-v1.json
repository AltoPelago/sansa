        "operation": "query",
        "namespace": "properties",
        "source": "from $.document\nwhere exists(.&key(\"document\"))\nselect .&key(\"document\")",
        "reenter": {
          "callback": "key",
          "source": "from $.document\nselect .&key(\"document\")",
          "maxPropertyInspections": 1
