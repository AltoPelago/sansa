    {
      "id": "sansa-properties-query-unsupported-empty",
      "description": "query unsupported empty",
      "input": {
        "operation": "query",
        "namespace": "properties",
        "source": "from $.missing\nwhere false\nselect .&tag(\"catalog\")",
        "omit": [
          "nodeHeads"
        ]
      },
      "expected": {
        "ok": false,
        "records": [],
        "error": "SANSA_RESOLVE_UNSUPPORTED_TAG",
        "calls": {
          "scope": 0,
          "children": 0
        },
        "phase": "policy"
      },
      "covers": [
        "query"
      ]
    },
    {
      "id": "sansa-properties-query-shared-exact",
      "description": "query shared exact",
      "input": {
        "operation": "query",
        "namespace": "properties",
        "source": "from $.*&key(\"document\")\nwhere exists(.&tag(\"catalog\"))\nselect .&key(\"document\")",
        "options": {
          "resolve": {
            "maxPropertyInspections": 16
          }
        }
      },
      "expected": {
        "ok": true,
        "records": [
          {
            "candidate": "doc",
            "valueBindings": [
              "doc"
            ]
          }
        ],
        "calls": {
          "scope": 16,
          "key": 14
        }
      },
      "covers": [
        "query"
      ]
    },
    {
      "id": "sansa-properties-query-shared-overflow",
      "description": "query shared overflow",
      "input": {
        "operation": "query",
        "namespace": "properties",
        "source": "from $.*&key(\"document\")\nwhere exists(.&tag(\"catalog\"))\nselect .&key(\"document\")",
        "options": {
          "resolve": {
            "maxPropertyInspections": 15
          }
        }
      },
      "expected": {
        "ok": false,
        "records": [],
        "error": "SANSA_RESOLVE_PROPERTY_LIMIT_EXCEEDED",
        "limit": 15,
        "observed": 16,
        "budget": "maxPropertyInspections",
        "phase": "select"
      },
      "covers": [
        "query"
      ]
    },
